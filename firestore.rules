rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Document racine utilisateur — utilisé par la Finance (index.html), champ `state`.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Sous-collections utilisateur — utilisées par le module Tâches (tasks, routines, goals)
    // ainsi que par tout futur module suivant la même convention users/{uid}/<collection>.
    match /users/{userId}/{collection}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
